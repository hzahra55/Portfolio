# ============================================================
# All values are OPTIONAL for the site to render.
# Empty/missing values will gracefully degrade (static fallback content,
# disabled contact form with mailto: alternative).
# ============================================================

# --- Database (Neon Postgres) ---
# When empty, the site reads from data/content.ts (static fallback).
# When set, the site reads from Postgres via Prisma.
DATABASE_URL=
DIRECT_URL=

# --- Cloudinary (image hosting) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (contact form email) ---
# When empty, the contact form falls back to a mailto: link UX.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=hudazahrabangash@gmail.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
